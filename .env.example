# Telegram bot token (required)
TOKEN=

# Currency rates data sources API keys (required)
EXCHANGE_RATE_API_KEY=
COINMARKETCAP_API_KEY=

UPDATE_VOLATILE_PERIOD_IN_HOURS=1

# Bot identity & webhook (HOST required only when DEBUG=false)
HOST=
BOT_NAME=textUtilsBot
APP_PORT=8080

# gRPC integration with user-service
GRPC_ADDR_USER_SERVICE=user-service:8090
USER_SERVICE_CACHE_MAX_SIZE=128
USER_SERVICE_CACHE_TIME=300

# Optional proxy for Telegram API access
#PROXY=http://127.0.0.1:2080

# Polling mode for local dev; false = webhooks in production
DEBUG=true

# Backup to S3 via rclone (requires /config/rclone.conf to be mounted)
#BACKUP_S3_BUCKET=kozalo-backup-textutilsbot
#BACKUP_CRON=0 3 * * *
#BACKUP_KEEP_DAYS=30
